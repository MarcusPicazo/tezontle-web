---
import Layout from '../../layouts/Layout.astro';
import { en } from '../../i18n/en';
import { legal } from '../../data/site';

const dict = {
  ...en,
  meta: { title: en.privacyPage.title, description: en.privacyPage.sections[0].body },
};
---

<Layout dict={dict} path="/en/privacy" alternatePath="/privacidad">
  <main id="contenido" class="min-h-dvh bg-arena px-6 py-28 text-grafito sm:px-10">
    <div class="mx-auto w-full max-w-2xl">
      <h1 class="font-display text-3xl sm:text-4xl">{en.privacyPage.heading}</h1>
      <p class="mt-3 text-sm text-grafito/70">{en.privacyPage.updatedLabel}: {legal.lastUpdated}</p>

      <div class="mt-10 space-y-8">
        {
          en.privacyPage.sections.map((section) => (
            <section>
              <h2 class="font-display text-xl text-grafito">{section.heading}</h2>
              <p class="mt-2 text-grafito/80">{section.body}</p>
            </section>
          ))
        }
      </div>

      <p class="mt-10 text-grafito/80">
        {legal.legalName} · {legal.address}
        <br />
        <a href={`mailto:${legal.privacyEmail}`} class="link">{legal.privacyEmail}</a>
      </p>

      <a href="/en/" class="btn btn-ghost-dark mt-10 inline-flex">{en.privacyPage.back}</a>
    </div>
  </main>
</Layout>
