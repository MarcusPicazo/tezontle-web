---
// Textura de piedra procedural (SVG + feTurbulence), no una foto: no tenemos una
// fotografía real de tezontle y esto evita inventar una. El filtro tiñe el ruido
// directamente de color piedra (#8C857B) sobre un fondo noche, sin degradados.
interface Props {
  class?: string;
  /** Único por página si se usa StoneTexture más de una vez (los id de filtro SVG no pueden repetirse). */
  id?: string;
}

const { class: className = '', id: filterId = 'piedra-grano' } = Astro.props;
---

<svg
  class:list={['block', className]}
  viewBox="0 0 100 100"
  preserveAspectRatio="none"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <filter id={filterId} x="0%" y="0%" width="100%" height="100%">
    <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="4" seed="7" stitchTiles="stitch" result="ruido"
    ></feTurbulence>
    <feColorMatrix
      in="ruido"
      type="matrix"
      values="0 0 0 0 0.549
              0 0 0 0 0.522
              0 0 0 0 0.482
              0 0 0 1.2 0.08"
    ></feColorMatrix>
  </filter>
  <rect width="100%" height="100%" fill="#15171c"></rect>
  <rect width="100%" height="100%" filter={`url(#${filterId})`}></rect>
</svg>
