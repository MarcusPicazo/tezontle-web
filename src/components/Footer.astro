---
import type { Dictionary } from '../i18n/types';
import { brand, site } from '../data/site';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const year = new Date().getFullYear();
const privacyHref = dict.lang === 'es' ? '/privacidad' : '/en/privacy';
const altHref = dict.lang === 'es' ? '/en/' : '/';
---

<footer class="relative z-10 border-t border-piedra/20 bg-cal px-6 py-10 text-grafito sm:px-10">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-display text-sm text-tinta-suave">
      © {year} {brand.fullName}. {dict.footer.rights}
    </p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
      <a href={privacyHref} class="link decoration-grafito/30 hover:decoration-laton">
        {dict.footer.privacy}
      </a>
      <a href={`mailto:${site.email}`} class="link decoration-grafito/30 hover:decoration-laton">
        {dict.footer.contactLabel}: {site.email}
      </a>
      <a
        href={altHref}
        aria-label={dict.nav.switchToLabel}
        class="link decoration-grafito/30 hover:decoration-laton"
      >
        {dict.nav.switchTo}
      </a>
    </div>
  </div>
</footer>
