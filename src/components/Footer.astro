---
import type { Dictionary } from '../i18n/types';
import { brand, site, whatsappHref } from '../data/site';
import T from './T.astro';
import { es } from '../i18n/es';
import { en } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const year = new Date().getFullYear();
const privacyHref = dict.lang === 'es' ? '/privacidad' : '/en/privacy';
const altHref = dict.lang === 'es' ? '/en/' : '/';
---

<!-- Fondo grafito sólido (el único "oscuro" fuera de noche que permite la SPEC: §2 dice que
     grafito es para texto/UI, no restringido a un uso único como noche o latón), compacto:
     dos filas en vez del pie extendido de antes. -->
<footer class="relative z-10 bg-grafito px-6 py-10 text-cal sm:px-10">
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-display text-lg text-cal">{brand.name}</p>
        <T
          as="p"
          es={es.footer.tagline}
          en={en.footer.tagline}
          lang={dict.lang}
          class="mt-1.5 block max-w-xs text-sm text-cal/60"
        />
      </div>

      <div class="flex items-center gap-3">
        <a
          href={`mailto:${site.email}`}
          aria-label={dict.footer.contactLabel}
          class="footer-icon"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2.5"></rect>
            <path d="m3.5 6 8.5 7 8.5-7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a href={whatsappHref} aria-label={dict.footer.whatsappLabel} class="footer-icon">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.15-.15.3-.37.44-.56.15-.2.2-.35.3-.56.1-.2.05-.37-.02-.52-.07-.15-.68-1.63-.93-2.23-.25-.6-.5-.5-.68-.5-.17 0-.4-.02-.6-.02-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.1 3.2 5.1 4.37 2.99 1.17 2.99.78 3.52.73.53-.05 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"></path>
            <path d="M12 2.5A9.5 9.5 0 0 0 4 17l-1.3 4.5 4.6-1.27A9.5 9.5 0 1 0 12 2.5Zm0 1.8a7.7 7.7 0 0 1 6.03 12.5l-.22.28.32.3-.6 2.08-2.14-.56-.3.17A7.7 7.7 0 1 1 12 4.3Z"></path>
          </svg>
        </a>
        <a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={dict.footer.linkedinLabel} class="footer-icon">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M6.94 8.5H3.56V20.5H6.94V8.5Z"></path>
            <path d="M5.25 7.02a1.96 1.96 0 1 0 0-3.92 1.96 1.96 0 0 0 0 3.92Z"></path>
            <path d="M20.5 20.5h-3.38v-6.1c0-1.45-.03-3.32-2.03-3.32-2.03 0-2.34 1.59-2.34 3.22v6.2H9.37V8.5h3.24v1.64h.05c.45-.85 1.56-1.75 3.21-1.75 3.43 0 4.63 2.26 4.63 5.19v6.92Z"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-cal/10 pt-6 text-xs text-cal/60">
      <p>
        © {year} {brand.fullName}. <T es={es.footer.rights} en={en.footer.rights} lang={dict.lang} />
      </p>
      <a href={privacyHref} class="link decoration-cal/25 hover:decoration-laton hover:text-cal">
        <T es={es.footer.privacy} en={en.footer.privacy} lang={dict.lang} />
      </a>
      <a href={altHref} aria-label={dict.nav.switchToLabel} class="link decoration-cal/25 hover:decoration-laton hover:text-cal">
        {dict.nav.switchTo}
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    color: var(--color-cal);
    background-color: rgba(255, 255, 255, 0.06);
    transition:
      background-color 300ms var(--ease-fluid),
      color 300ms var(--ease-fluid);
  }

  .footer-icon:hover,
  .footer-icon:focus-visible {
    color: var(--color-grafito);
    background-color: var(--color-laton);
  }
</style>
