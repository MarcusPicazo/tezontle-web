---
// Botón flotante de WhatsApp, fijo en la esquina inferior derecha, visible en todo el
// recorrido (no una escena más): estética del sitio, latón con el ícono en grafito — igual
// que cualquier botón principal (SPEC §2: latón nunca como texto, aquí es el fondo), nunca
// el verde de marca de WhatsApp. Entrada animada en src/scripts/whatsappFab.ts; el
// hover/press son puro CSS aquí abajo.
import { whatsappHref } from '../data/site';
---

<a
  id="whatsapp-fab"
  href={whatsappHref}
  target="_blank"
  rel="noopener noreferrer"
  data-analytics-event="WhatsApp flotante"
  aria-label="WhatsApp"
  class="whatsapp-fab fixed right-4 bottom-6 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-laton text-grafito shadow-2xl shadow-noche/30 sm:right-6"
>
  <svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.15-.15.3-.37.44-.56.15-.2.2-.35.3-.56.1-.2.05-.37-.02-.52-.07-.15-.68-1.63-.93-2.23-.25-.6-.5-.5-.68-.5-.17 0-.4-.02-.6-.02-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.1 3.2 5.1 4.37 2.99 1.17 2.99.78 3.52.73.53-.05 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"></path>
    <path d="M12 2.5A9.5 9.5 0 0 0 4 17l-1.3 4.5 4.6-1.27A9.5 9.5 0 1 0 12 2.5Zm0 1.8a7.7 7.7 0 0 1 6.03 12.5l-.22.28.32.3-.6 2.08-2.14-.56-.3.17A7.7 7.7 0 1 1 12 4.3Z"></path>
  </svg>
</a>

<style>
  .whatsapp-fab {
    /* Entrada la pone en 0 (whatsappFab.ts): sin JS (o antes de que corra) se ve normal,
       nunca invisible. */
    transition:
      transform 300ms var(--ease-fluid),
      box-shadow 300ms var(--ease-fluid);
  }

  .whatsapp-fab:hover {
    transform: scale(1.08);
    box-shadow:
      0 20px 40px -8px rgba(21, 23, 28, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset;
  }

  .whatsapp-fab:active {
    transform: scale(0.92);
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab {
      transition: none;
    }
  }
</style>
