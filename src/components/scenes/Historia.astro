---
import Scene from '../Scene.astro';
import T from '../T.astro';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import type { Dictionary } from '../../i18n/types';

interface Props {
  lang: Dictionary['lang'];
}

const { lang } = Astro.props;
const t = { es: es.scenes.historia, en: en.scenes.historia };
---

<Scene id="historia" tone="noche" dark>
  <span
    data-reveal
    class="inline-flex items-center gap-2 rounded-full bg-laton/20 px-3 py-1 text-sm font-semibold text-cal"
  >
    <T es={t.es.tag} en={t.en.tag} lang={lang} />
  </span>
  <T
    as="h2"
    es={t.es.heading}
    en={t.en.heading}
    lang={lang}
    class="mt-6 block max-w-2xl font-display text-3xl text-cal sm:text-5xl"
    data-reveal
    style="--d:120ms"
  />
  <div
    data-reveal
    style="--d:260ms"
    class="relative mt-10 aspect-video w-full max-w-xl overflow-hidden rounded-2xl ring-1 ring-cal/15"
  >
    <!-- Lugar del video (public/video/aura-recorrido.mp4, se agrega después): mientras
         tanto, su póster. Cuando el archivo exista, esto se vuelve un <video> real. -->
    <img
      src="/video/aura-recorrido-poster.svg"
      alt={lang === 'es' ? t.es.heading : t.en.heading}
      class="h-full w-full object-cover"
      width="1280"
      height="720"
      loading="lazy"
    />
    <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-cal/90 shadow-lg">
        <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 text-grafito" fill="currentColor">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </span>
    </span>
  </div>
</Scene>
