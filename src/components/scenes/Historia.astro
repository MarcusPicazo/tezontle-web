---
import Scene from '../Scene.astro';
import Pending from '../Pending.astro';
import type { Dictionary } from '../../i18n/types';

interface Props {
  t: Dictionary['scenes']['historia'];
}

const { t } = Astro.props;
---

<Scene id="historia" tone="noche">
  <span
    data-reveal
    class="inline-flex items-center gap-2 rounded-full bg-laton/15 px-3 py-1 text-sm font-semibold text-laton"
  >
    {t.tag}
  </span>
  <h2 class="mt-6 max-w-2xl font-display text-3xl text-cal sm:text-5xl" data-reveal style="--d:120ms">
    {t.heading}
  </h2>
  <div
    data-reveal
    style="--d:260ms"
    class="mt-10 aspect-video w-full max-w-xl rounded-2xl bg-cal/5 ring-1 ring-cal/15"
  >
  </div>
  <Pending class="mt-4 max-w-xl bg-cal/10 text-cal/70 ring-cal/20">
    Video en public/video/aura-recorrido.mp4 (se agrega después).
  </Pending>
</Scene>
