---
import Scene from '../Scene.astro';
import Pending from '../Pending.astro';
import type { Dictionary } from '../../i18n/types';

interface Props {
  t: Dictionary['scenes']['historia'];
}

const { t } = Astro.props;
---

<Scene id="historia" tone="noche">
  <span
    data-reveal
    class="inline-flex items-center gap-2 rounded-full bg-laton/15 px-3 py-1 text-sm font-semibold text-laton"
  >
    {t.tag}
  </span>
  <h2 class="mt-6 max-w-2xl font-display text-3xl text-cal sm:text-5xl" data-reveal style="--d:120ms">
    {t.heading}
  </h2>
  <div
    data-reveal
    style="--d:260ms"
    class="relative mt-10 aspect-video w-full max-w-xl overflow-hidden rounded-2xl ring-1 ring-cal/15"
  >
    <!-- Lugar del video (public/video/aura-recorrido.mp4, se agrega después): mientras
         tanto, su póster. Cuando el archivo exista, esto se vuelve un <video> real. -->
    <img
      src="/video/aura-recorrido-poster.svg"
      alt={t.heading}
      class="h-full w-full object-cover"
      width="1280"
      height="720"
      loading="lazy"
    />
    <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-cal/90 shadow-lg">
        <svg viewBox="0 0 24 24" class="ml-1 h-6 w-6 text-grafito" fill="currentColor">
          <path d="M8 5v14l11-7z"></path>
        </svg>
      </span>
    </span>
  </div>
  <Pending class="mt-4 max-w-xl bg-cal/10 text-cal/70 ring-cal/20">
    Falta public/video/aura-recorrido.mp4: cuando exista, cambiar el &lt;img&gt; del póster por
    &lt;video poster="/video/aura-recorrido-poster.svg" controls&gt;.
  </Pending>
</Scene>
