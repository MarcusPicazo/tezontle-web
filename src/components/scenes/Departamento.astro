---
import Scene from '../Scene.astro';
import type { Dictionary } from '../../i18n/types';

interface Props {
  t: Dictionary['scenes']['departamento'];
}

const { t } = Astro.props;
---

<Scene id="departamento" tone="cal">
  <h2 class="max-w-2xl font-display text-3xl text-grafito sm:text-5xl" data-reveal>
    {t.heading}
  </h2>
  <div class="mt-10 flex flex-wrap items-start gap-6">
    <ul class="flex flex-wrap gap-2" data-reveal style="--d:150ms">
      {
        t.fichaLabels.map((label) => (
          <li class="rounded-full bg-grafito/5 px-4 py-1.5 text-sm font-semibold text-piedra ring-1 ring-grafito/10">
            {label}
          </li>
        ))
      }
    </ul>
  </div>
  <p
    data-reveal
    style="--d:280ms"
    class="mt-6 inline-flex max-w-xs rounded-2xl rounded-bl-sm bg-grafito px-4 py-3 text-sm text-arena"
  >
    {t.whatsappMessage}
  </p>
</Scene>
