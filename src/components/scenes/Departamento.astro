---
import Scene from '../Scene.astro';
import StillBackground from '../StillBackground.astro';
import type { Dictionary } from '../../i18n/types';

interface Props {
  t: Dictionary['scenes']['departamento'];
}

const { t } = Astro.props;
const [planoLabel, precioLabel, pagosLabel] = t.fichaLabels;
---

<Scene id="departamento" tone="media">
  <!-- SPEC §3: durante las escenas 3-5 el fondo es el último cuadro de clip-2 (la torre
       completa), atenuado. Esta escena vive dentro del mismo ScrollWorld que Torre (ver
       HomeContent.astro): el fondo es el mismo fotograma fijo, sin cortes. StillBackground es
       solo el respaldo para cuando no hay ese mundo con video (sin JS o SPEC §4). -->
  <StillBackground src="/escenas/3-torre.jpg" />
  <!-- "Un poco atenuado" (SPEC), no borrado: la torre debe seguir viéndose casi como en la
       escena 3; el celular resalta por su propia sombra, no porque el fondo desaparezca. -->
  <div class="absolute inset-0 -z-10 bg-linear-to-b from-transparent via-arena/15 via-50% to-arena/15" aria-hidden="true">
  </div>
  <div class="flex flex-col gap-10 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="max-w-xl font-display text-3xl text-grafito sm:text-5xl" data-reveal>
      {t.heading}
    </h2>

    <div class="mx-auto w-[220px] shrink-0 sm:mx-0">
      <!-- Mockup de celular: HTML/CSS sobre la escena, no una imagen. -->
      <div
        data-reveal
        style="--d:180ms"
        class="rounded-[2.25rem] border-[6px] border-grafito bg-grafito p-2 shadow-2xl shadow-noche"
      >
        <div class="mx-auto mb-2 h-1.5 w-12 rounded-full bg-cal/30" aria-hidden="true"></div>
        <div class="rounded-[1.5rem] bg-cal px-4 py-4">
          <svg
            viewBox="0 0 64 44"
            class="h-11 w-16 text-piedra"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <rect x="2" y="2" width="60" height="40" rx="2"></rect>
            <line x1="32" y1="2" x2="32" y2="26"></line>
            <line x1="2" y1="26" x2="62" y2="26"></line>
          </svg>
          <dl class="mt-4 space-y-3 text-xs">
            <div class="flex items-center justify-between">
              <dt class="font-semibold text-grafito">{planoLabel}</dt>
              <dd class="h-2 w-10 rounded-full bg-grafito/15" aria-hidden="true"></dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="font-semibold text-grafito">{precioLabel}</dt>
              <dd class="h-2 w-14 rounded-full bg-grafito/15" aria-hidden="true"></dd>
            </div>
            <div>
              <dt class="font-semibold text-grafito">{pagosLabel}</dt>
              <dd class="mt-1.5 flex gap-1" aria-hidden="true">
                <span class="h-1.5 flex-1 rounded-full bg-laton/50"></span>
                <span class="h-1.5 flex-1 rounded-full bg-laton/50"></span>
                <span class="h-1.5 flex-1 rounded-full bg-laton/50"></span>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <p
        data-reveal
        style="--d:320ms"
        class="mt-4 max-w-[220px] rounded-2xl rounded-bl-sm bg-grafito px-4 py-3 text-sm text-arena shadow-lg"
      >
        {t.whatsappMessage}
      </p>
    </div>
  </div>
</Scene>
