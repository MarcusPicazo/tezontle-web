---
import Scene from '../Scene.astro';
import type { Dictionary } from '../../i18n/types';

interface Props {
  t: Dictionary['scenes']['comoTrabajamos'];
}

const { t } = Astro.props;
---

<Scene id="comoTrabajamos" tone="cal">
  <h2 class="font-display text-3xl text-grafito sm:text-5xl" data-reveal>
    {t.heading}
  </h2>
  <ol class="mt-12 grid gap-4 sm:grid-cols-3">
    {
      t.steps.map((step, i) => (
        <li data-reveal style={`--d:${150 + i * 120}ms`} class="rounded-2xl bg-arena px-6 py-8 ring-1 ring-grafito/10">
          <span class="font-display text-2xl text-laton">{String(i + 1).padStart(2, '0')}</span>
          <p class="mt-3 text-grafito">{step}</p>
        </li>
      ))
    }
  </ol>
</Scene>
