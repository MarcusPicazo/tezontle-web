---
import Scene from '../Scene.astro';
import T from '../T.astro';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import type { Dictionary } from '../../i18n/types';

interface Props {
  lang: Dictionary['lang'];
}

const { lang } = Astro.props;
const t = { es: es.scenes.comoTrabajamos, en: en.scenes.comoTrabajamos };
---

<Scene id="comoTrabajamos" tone="cal">
  <T as="h2" es={t.es.heading} en={t.en.heading} lang={lang} class="block font-display text-3xl text-grafito sm:text-5xl" data-reveal />
  <ol class="mt-12 grid gap-4 sm:grid-cols-3">
    {
      t.es.steps.map((step, i) => (
        <li data-reveal style={`--d:${150 + i * 120}ms`} class="rounded-2xl bg-arena px-6 py-8 ring-1 ring-grafito/10">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-laton font-display text-base text-grafito">
            {String(i + 1).padStart(2, '0')}
          </span>
          <T as="p" es={step} en={t.en.steps[i]} lang={lang} class="mt-3 block text-grafito" />
        </li>
      ))
    }
  </ol>
</Scene>
