---
import Scene from '../Scene.astro';
import StillBackground from '../StillBackground.astro';
import T from '../T.astro';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import type { Dictionary } from '../../i18n/types';
import { site, whatsappHref } from '../../data/site';

interface Props {
  lang: Dictionary['lang'];
}

const { lang } = Astro.props;
const t = { es: es.scenes.cierre, en: en.scenes.cierre };

// demoUrl, calendarUrl y whatsapp.number en src/data/site.ts son placeholders.
---

<Scene id="cierre" tone="media" pin>
  <StillBackground src="/escenas/4-atardecer.jpg" />
  <T
    as="h2"
    es={t.es.heading}
    en={t.en.heading}
    lang={lang}
    class="block max-w-xl font-display text-4xl text-grafito sm:text-6xl"
    data-reveal
  />
  <!-- Entra hasta el último tramo del fijado (SPEC: escena 9), no desde el inicio como el
       resto de [data-reveal]: src/scripts/motion.ts lo controla con el scroll, no con el
       IntersectionObserver genérico. -->
  <div data-reveal data-pin-reveal class="mt-10 flex flex-wrap gap-3">
    <a href={site.demoUrl} data-analytics-event="Ver demo" class="btn btn-primary">
      <T es={t.es.buttons.demo} en={t.en.buttons.demo} lang={lang} />
    </a>
    <a href={site.calendarUrl} data-analytics-event="Agendar" class="btn btn-ghost-dark">
      <T es={t.es.buttons.agendar} en={t.en.buttons.agendar} lang={lang} />
    </a>
    <a href={whatsappHref} data-analytics-event="WhatsApp" class="btn btn-ghost-dark">
      <T es={t.es.buttons.whatsapp} en={t.en.buttons.whatsapp} lang={lang} />
    </a>
  </div>
</Scene>
