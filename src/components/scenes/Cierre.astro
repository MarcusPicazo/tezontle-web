---
import Scene from '../Scene.astro';
import StillBackground from '../StillBackground.astro';
import T from '../T.astro';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import type { Dictionary } from '../../i18n/types';
import { site, whatsappHref } from '../../data/site';

interface Props {
  lang: Dictionary['lang'];
}

const { lang } = Astro.props;
const t = { es: es.scenes.cierre, en: en.scenes.cierre };

// demoUrl, calendarUrl y whatsapp.number en src/data/site.ts son placeholders.
---

<Scene id="cierre" tone="media" pin>
  <StillBackground src="/escenas/4-atardecer.jpg" />
  <!-- Título, línea de progreso y botones ligados al scroll del fijado (no de golpe):
       src/scripts/cierrePin.ts. data-pin-reveal los saca del IntersectionObserver genérico
       de motion.ts; data-reveal es el respaldo con prefers-reduced-motion (fade simple, sin
       palabra por palabra ni línea). -->
  <T
    as="h2"
    id="cierre-title"
    es={t.es.heading}
    en={t.en.heading}
    lang={lang}
    class="block max-w-xl font-display text-4xl text-grafito sm:text-6xl"
    data-reveal
    data-pin-reveal
  />
  <div id="cierre-progress" class="mt-6 h-px w-full max-w-xs rounded-full bg-grafito/15" aria-hidden="true">
    <div id="cierre-progress-fill" class="h-full w-0 rounded-full bg-laton"></div>
  </div>
  <!-- Fondo sólido (no backdrop-blur) en los botones "fantasma": sin fondo, el de WhatsApp
       (el que más a la derecha cae, fuera del velo del lado del texto) se perdía contra la
       foto del atardecer. Un blur de fondo aquí (probado primero) duplicaba visualmente el
       texto al hacer scroll: este bloque va dentro de la escena fijada (sticky + scrub,
       cierrePin.ts) y backdrop-filter sobre un elemento que se mueve así genera fantasmas de
       repintado en Chromium. Sólido además es más barato en celular (SPEC: rendimiento). -->
  <div id="cierre-buttons" data-reveal data-pin-reveal class="mt-8 flex flex-wrap gap-3">
    <a href={site.demoUrl} data-analytics-event="Ver demo" class="btn btn-primary">
      <T es={t.es.buttons.demo} en={t.en.buttons.demo} lang={lang} />
    </a>
    <a href={site.calendarUrl} data-analytics-event="Agendar" class="btn btn-ghost-dark bg-cal shadow-md">
      <T es={t.es.buttons.agendar} en={t.en.buttons.agendar} lang={lang} />
    </a>
    <a href={whatsappHref} data-analytics-event="WhatsApp" class="btn btn-ghost-dark bg-cal shadow-md">
      <svg viewBox="0 0 24 24" class="-ml-0.5 h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
        <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.76-1.66-2.06-.17-.3-.02-.46.13-.61.15-.15.3-.37.44-.56.15-.2.2-.35.3-.56.1-.2.05-.37-.02-.52-.07-.15-.68-1.63-.93-2.23-.25-.6-.5-.5-.68-.5-.17 0-.4-.02-.6-.02-.2 0-.52.07-.8.37-.27.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.1 3.2 5.1 4.37 2.99 1.17 2.99.78 3.52.73.53-.05 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"></path>
        <path d="M12 2.5A9.5 9.5 0 0 0 4 17l-1.3 4.5 4.6-1.27A9.5 9.5 0 1 0 12 2.5Zm0 1.8a7.7 7.7 0 0 1 6.03 12.5l-.22.28.32.3-.6 2.08-2.14-.56-.3.17A7.7 7.7 0 1 1 12 4.3Z"></path>
      </svg>
      <T es={t.es.buttons.whatsapp} en={t.en.buttons.whatsapp} lang={lang} />
    </a>
  </div>
</Scene>
