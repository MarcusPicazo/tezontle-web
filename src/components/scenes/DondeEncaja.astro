---
import Scene from '../Scene.astro';
import T from '../T.astro';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import type { Dictionary } from '../../i18n/types';

interface Props {
  lang: Dictionary['lang'];
}

const { lang } = Astro.props;
const t = { es: es.scenes.dondeEncaja, en: en.scenes.dondeEncaja };
---

<Scene id="dondeEncaja" tone="cal">
  <T
    as="h2"
    es={t.es.heading}
    en={t.en.heading}
    lang={lang}
    class="block max-w-2xl font-display text-3xl text-grafito sm:text-5xl"
    data-reveal
  />

  <!-- "5 pasos en línea" (SPEC): fila en escritorio, columna en celular, con una flecha
       entre cada paso para que se lea como secuencia, no como 5 tarjetas sueltas. -->
  <ol class="mt-12 flex flex-col items-stretch gap-3 lg:flex-row lg:items-center lg:gap-3">
    {
      t.es.steps.map((stepEs, i) => (
        <>
          <li
            data-reveal
            style={`--d:${100 + i * 90}ms`}
            class="flex-1 rounded-2xl bg-arena px-5 py-6 ring-1 ring-grafito/10"
          >
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-laton font-display text-sm text-grafito">
              {i + 1}
            </span>
            <T as="p" es={stepEs} en={t.en.steps[i]} lang={lang} class="mt-3 block text-sm text-grafito" />
          </li>
          {i < t.es.steps.length - 1 && (
            <li aria-hidden="true" class="flex shrink-0 items-center justify-center text-piedra lg:rotate-0">
              <svg viewBox="0 0 24 24" class="h-5 w-5 rotate-90 lg:rotate-0" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </li>
          )}
        </>
      ))
    }
  </ol>
</Scene>
