---
import Scene from '../Scene.astro';
import type { Dictionary } from '../../i18n/types';

interface Props {
  t: Dictionary['scenes']['nombre'];
}

const { t } = Astro.props;
---

<Scene id="nombre" tone="media">
  <!-- Imagen a pantalla completa (SPEC §3 escena 8): es oscura, así que el texto va en cal
       sobre un degradado oscuro del lado del texto (máximo 40% del ancho), no sobre el velo
       claro de las demás escenas con media. Arriba y abajo se desvanece hacia las escenas
       vecinas (cal antes, arena después) para que no se note un corte duro. -->
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <!-- Sin loading="lazy": a diferencia de los fondos de StillBackground (ocultos hasta que
         JS decide si hacen falta), esta imagen es el fondo real y siempre visible de la
         escena; con lazy no siempre terminaba de bajar los 288 KB antes de llegar aquí. -->
    <img src="/escenas/5-piedra-detalle.jpg" alt="" fetchpriority="low" class="h-full w-full object-cover" />
    <div
      class="absolute inset-0 bg-linear-to-r from-noche/70 from-0% via-noche/50 via-30% to-transparent to-70% sm:via-15% sm:to-40%"
    >
    </div>
    <div class="absolute inset-x-0 top-0 h-[15dvh] bg-linear-to-b from-cal to-transparent"></div>
    <div class="absolute inset-x-0 bottom-0 h-[15dvh] bg-linear-to-t from-arena to-transparent"></div>
  </div>
  <span aria-hidden="true" class="mb-8 block h-1.5 w-16 rounded-full bg-laton" data-reveal></span>
  <p class="max-w-2xl font-display text-2xl text-cal sm:text-4xl" data-reveal style="--d:120ms">
    {t.heading}
  </p>
</Scene>
