---
import Scene from '../Scene.astro';
import StillBackground from '../StillBackground.astro';
import T from '../T.astro';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import type { Dictionary } from '../../i18n/types';

interface Props {
  lang: Dictionary['lang'];
}

const { lang } = Astro.props;
const t = { es: es.scenes.experiencia, en: en.scenes.experiencia };
const [planoEs, precioEs, pagosEs] = t.es.fichaLabels;
const [planoEn, precioEn, pagosEn] = t.en.fichaLabels;
---

<!-- Escena B: experiencia del comprador. Fijada (como Cierre, pero más corta: ver
     pinHeight) para que, dentro de una sola pantalla, la torre termine de subir (clip-2,
     ocupa todo el fijado) y LUEGO entren el celular y WhatsApp — src/scripts/experienciaPin.ts
     controla ese orden ligado al scroll. -->
<Scene id="experiencia" tone="media" pin pinHeight="150dvh">
  <StillBackground src="/escenas/3-torre.jpg" />
  <div class="flex flex-col gap-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <T
        as="span"
        es={t.es.tag}
        en={t.en.tag}
        lang={lang}
        data-reveal
        class="inline-flex items-center gap-2 rounded-full bg-laton/20 px-3 py-1 text-sm font-semibold text-grafito"
      />
      <T
        as="h2"
        es={t.es.heading}
        en={t.en.heading}
        lang={lang}
        class="mt-6 block font-display text-3xl text-grafito sm:text-5xl"
        data-reveal
        style="--d:120ms"
      />
    </div>

    <div class="mx-auto w-[220px] shrink-0 sm:mx-0">
      <!-- Ocultos hasta que experienciaPin.ts los revela (no [data-reveal]: ese observer es
           genérico por IntersectionObserver, y esto necesita ir ligado al progreso del
           fijado, no solo a si ya entró en pantalla — igual que los botones de Cierre. -->
      <div id="experiencia-phone" class="rounded-[2.25rem] border-[6px] border-grafito bg-grafito p-2 shadow-2xl shadow-noche">
        <div class="mx-auto mb-2 h-1.5 w-12 rounded-full bg-cal/30" aria-hidden="true"></div>
        <div class="rounded-[1.5rem] bg-cal px-4 py-4">
          <svg
            viewBox="0 0 64 44"
            class="h-11 w-16 text-piedra"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6H58" stroke-width="3"></path>
            <path d="M6 6V38" stroke-width="3"></path>
            <path d="M58 6V38" stroke-width="3"></path>
            <path d="M6 38H24M40 38H58" stroke-width="3"></path>
            <path d="M24 38V22" stroke-width="1.5"></path>
            <path d="M40 38 A16 16 0 0 1 24 22" stroke-width="1"></path>
            <path d="M28 3H46M28 3V6M46 3V6" stroke-width="1.5"></path>
          </svg>
          <dl class="mt-4 space-y-3 text-xs">
            <div class="flex items-center justify-between">
              <T as="dt" es={planoEs} en={planoEn} lang={lang} class="block font-semibold text-grafito" />
              <dd class="h-2 w-10 rounded-full bg-grafito/15" aria-hidden="true"></dd>
            </div>
            <div class="flex items-center justify-between">
              <T as="dt" es={precioEs} en={precioEn} lang={lang} class="block font-semibold text-grafito" />
              <dd class="h-2 w-14 rounded-full bg-grafito/15" aria-hidden="true"></dd>
            </div>
            <div>
              <T as="dt" es={pagosEs} en={pagosEn} lang={lang} class="block font-semibold text-grafito" />
              <dd class="mt-1.5 flex gap-1" aria-hidden="true">
                <span class="h-1.5 flex-1 rounded-full bg-laton/50"></span>
                <span class="h-1.5 flex-1 rounded-full bg-laton/50"></span>
                <span class="h-1.5 flex-1 rounded-full bg-laton/50"></span>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <T
        as="p"
        id="experiencia-whatsapp"
        es={t.es.whatsappMessage}
        en={t.en.whatsappMessage}
        lang={lang}
        class="mt-4 block max-w-[220px] rounded-2xl rounded-bl-sm bg-grafito px-4 py-3 text-sm text-arena shadow-lg"
      />
    </div>
  </div>
</Scene>
