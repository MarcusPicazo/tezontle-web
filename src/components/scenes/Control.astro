---
import Scene from '../Scene.astro';
import StillBackground from '../StillBackground.astro';
import T from '../T.astro';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import type { Dictionary } from '../../i18n/types';

interface Props {
  lang: Dictionary['lang'];
}

const { lang } = Astro.props;
const t = { es: es.scenes.control, en: en.scenes.control };

// El punto de la fila enfocada arranca "disponible"; src/scripts/motion.ts lo anima a
// "vendida" con el mismo scroll que recorre esta escena.
const AVAILABLE_COLOR = '#4f9d6e';
const RESERVED_COLOR = '#d9a443';
---

<!-- Escena C: control del equipo comercial. Fondo compartido con Experiencia (mismo
     ScrollWorld): el último cuadro de clip-2 (la torre completa) se queda fijo, sin cortes. -->
<Scene id="control" tone="media">
  <StillBackground src="/escenas/3-torre.jpg" />
  <div class="absolute inset-0 -z-10 bg-arena/15" aria-hidden="true"></div>
  <div class="flex flex-col gap-10 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <T
        as="span"
        es={t.es.tag}
        en={t.en.tag}
        lang={lang}
        data-reveal
        class="inline-flex items-center gap-2 rounded-full bg-laton/20 px-3 py-1 text-sm font-semibold text-grafito"
      />
      <T
        as="h2"
        es={t.es.heading}
        en={t.en.heading}
        lang={lang}
        class="mt-6 block font-display text-3xl text-grafito sm:text-5xl"
        data-reveal
        style="--d:120ms"
      />
      <T
        as="p"
        es={t.es.small}
        en={t.en.small}
        lang={lang}
        class="mt-4 block text-sm text-piedra"
        data-reveal
        style="--d:220ms"
      />
    </div>

    <div class="mx-auto w-[300px] shrink-0 sm:mx-0" data-reveal style="--d:280ms">
      <div class="rounded-t-xl border-[6px] border-b-0 border-grafito bg-grafito p-3 shadow-2xl shadow-noche">
        <div class="rounded-md bg-cal px-4 py-3">
          <T
            as="p"
            es={t.es.tag}
            en={t.en.tag}
            lang={lang}
            class="block text-[11px] font-semibold tracking-wide text-grafito/70 uppercase"
          />
          <ul class="mt-3 space-y-1.5 text-sm text-grafito">
            <li class="flex items-center justify-between rounded-lg bg-grafito/5 px-3 py-2">
              <span>701</span>
              <span class="h-2.5 w-2.5 rounded-full" style={`background-color:${AVAILABLE_COLOR}`} aria-hidden="true"
              ></span>
            </li>
            <li class="flex items-center justify-between rounded-lg bg-laton/10 px-3 py-2 ring-1 ring-laton/30">
              <span class="font-semibold">804</span>
              <span
                id="panel-focus-dot"
                class="h-2.5 w-2.5 rounded-full transition-colors"
                style={`background-color:${AVAILABLE_COLOR}`}
                aria-hidden="true"
              ></span>
            </li>
            <li class="flex items-center justify-between rounded-lg bg-grafito/5 px-3 py-2">
              <span>902</span>
              <span class="h-2.5 w-2.5 rounded-full" style={`background-color:${RESERVED_COLOR}`} aria-hidden="true"
              ></span>
            </li>
          </ul>
        </div>
      </div>
      <div class="h-3 rounded-b-xl bg-grafito" aria-hidden="true"></div>
      <div class="mx-auto h-1.5 w-20 rounded-b-md bg-piedra" aria-hidden="true"></div>
    </div>
  </div>
</Scene>
