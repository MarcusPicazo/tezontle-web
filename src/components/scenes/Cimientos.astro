---
import Scene from '../Scene.astro';
import StillBackground from '../StillBackground.astro';
import type { Dictionary } from '../../i18n/types';

interface Props {
  t: Dictionary['scenes']['cimientos'];
}

const { t } = Astro.props;
---

<Scene id="cimientos" tone="canvas">
  <StillBackground src="/stills/cimientos.jpg" />
  <h2 class="max-w-2xl font-display text-3xl text-cal sm:text-5xl" data-reveal>
    {t.heading}
  </h2>
  <ul class="mt-12 grid gap-4 sm:grid-cols-3">
    {
      t.points.map((point, i) => (
        <li
          data-reveal
          style={`--d:${150 + i * 120}ms`}
          class="rounded-2xl bg-cal/10 px-6 py-8 ring-1 ring-cal/20 backdrop-blur-md"
        >
          <span aria-hidden="true" class="mb-4 block h-1.5 w-8 rounded-full bg-laton" />
          <p class="font-display text-lg text-cal">{point}</p>
        </li>
      ))
    }
  </ul>
</Scene>
