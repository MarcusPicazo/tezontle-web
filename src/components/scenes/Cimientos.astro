---
import Scene from '../Scene.astro';
import StillBackground from '../StillBackground.astro';
import T from '../T.astro';
import { es } from '../../i18n/es';
import { en } from '../../i18n/en';
import type { Dictionary } from '../../i18n/types';

interface Props {
  lang: Dictionary['lang'];
}

const { lang } = Astro.props;
const t = { es: es.scenes.cimientos, en: en.scenes.cimientos };
---

<Scene id="cimientos" tone="media">
  <StillBackground src="/escenas/2-cimientos.jpg" />
  <!-- Máximo la mitad izquierda (SPEC): la otra mitad es donde se ve el edificio. -->
  <div class="max-w-md">
    <T as="h2" es={t.es.heading} en={t.en.heading} lang={lang} class="block font-display text-3xl text-grafito sm:text-5xl" data-reveal />
    <ul class="mt-10 space-y-3">
      {
        t.es.points.map((point, i) => (
          <li data-reveal style={`--d:${150 + i * 120}ms`} class="rounded-2xl bg-cal px-6 py-5 ring-1 ring-grafito/10">
            <span aria-hidden="true" class="mb-3 block h-1.5 w-8 rounded-full bg-laton" />
            <T as="p" es={point} en={t.en.points[i]} lang={lang} class="block font-display text-lg text-grafito" />
          </li>
        ))
      }
    </ul>
  </div>
</Scene>
