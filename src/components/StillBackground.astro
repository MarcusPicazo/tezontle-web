---
// Fallback de SPEC §4: imagen fija de esta escena (public/escenas/). Visible por defecto
// para que funcione sin JS; src/styles/global.css la oculta solo cuando sí se anima el
// recorrido con video (ScrollWorld.astro).
interface Props {
  src: string;
}

const { src } = Astro.props;
---

<div class="still-bg absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <img src={src} alt="" class="h-full w-full object-cover" loading="lazy" />
</div>
