---
// Escenario fijo detrás de un grupo de escenas (SPEC §3 y §4): mientras el scroll avanza
// por las paradas que van dentro de este componente, el fotograma/clip de fondo avanza con
// ellas. Técnica de E:\arko-landing\src\components\ScrollWorld.astro, adaptada: aquí las
// "paradas" son las propias escenas del sitio ([data-scene], ya las pone Scene.astro), así
// que el raíl de progreso existente las sigue sin cambios.
interface Frame {
  src: string;
}

interface Clip {
  desktop: string;
  mobile: string;
}

interface Props {
  frames: Frame[];
  clips: Clip[];
  /** Solo el primer mundo de la página (escenas 1-3): su primer fotograma es lo primero que se pinta. */
  eager?: boolean;
}

const { frames, clips, eager = false } = Astro.props;
---

<section data-world class="relative">
  <div data-stage class="sticky top-0 h-dvh overflow-hidden bg-arena" style="--focus-x:78%">
    <div aria-hidden="true" class="absolute inset-0">
      {
        frames.map((frame, i) => (
          <picture data-frame class="frame absolute inset-0" style={i === 0 ? undefined : 'opacity:0'}>
            <img
              src={frame.src}
              alt=""
              loading={i === 0 && eager ? 'eager' : 'lazy'}
              fetchpriority={i === 0 && eager ? 'high' : 'low'}
              decoding="async"
              class="h-full w-full object-cover"
              style="object-position: var(--focus-x) 50%"
            />
          </picture>
        ))
      }
      <div class="clips absolute inset-0">
        {
          clips.map((clip) => (
            <video
              data-clip
              data-src-desktop={clip.desktop}
              data-src-mobile={clip.mobile}
              muted
              playsinline
              preload="none"
              disablepictureinpicture
              disableRemotePlayback
              tabindex="-1"
              class="clip absolute inset-0 h-full w-full object-cover"
              style="object-position: var(--focus-x) 50%"
            />
          ))
        }
      </div>
    </div>

    <!-- Degradados: solo del lado del texto y nada sobre el edificio. En celular el texto
         ocupa casi todo el ancho (no hay "mitad derecha" a la que no llegar), así que el
         velo cubre más; desde sm: (donde el texto sí queda a la izquierda) se achica al
         40% del ancho que pediste. Un desvanecido corto abajo evita el corte hacia el arena
         del resto del sitio. El fotograma/video se queda nítido y con su color real. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-linear-to-r from-arena from-0% via-arena/65 via-30% to-transparent to-70% sm:via-15% sm:to-40%"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 bottom-0 h-[12dvh] bg-linear-to-t from-arena to-transparent"
    >
    </div>
  </div>

  <div class="relative z-10 -mt-[100dvh]">
    <slot />
  </div>
</section>

<style>
  .frame {
    will-change: opacity, transform;
  }

  .clips {
    opacity: 0;
    transition: opacity 1200ms var(--ease-fluid);
  }

  [data-mode='video'] .clips {
    opacity: 1;
  }

  /* Solo se ve el clip del tramo actual; el cambio entre clips es instantáneo porque
     comparten fotograma en el punto de corte. */
  .clip {
    visibility: hidden;
  }

  .clip.is-shown {
    visibility: visible;
  }

  /* Oculto por defecto (sin JS, o con JS en modo capturas fijas): src/styles/global.css lo
     muestra solo cuando sí se va a animar con el scroll. */
  [data-stage] {
    display: none;
  }

  html.js:not(.stills) [data-stage] {
    display: block;
  }
</style>
