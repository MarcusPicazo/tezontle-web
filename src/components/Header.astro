---
// Header flotante (técnica de E:\referencias\taylor-website: index.html #navbar-wrapper,
// css/style.css #navbar/.floating-nav, js/animations.js el ScrollTrigger que pone esa
// clase), adaptado a los tokens de Tezontle. Una sola apariencia siempre (igual que la
// referencia): transparente arriba, vidrio esmerilado al pasar 50px — nunca cambia de tinte
// según la escena de atrás. src/scripts/header.ts solo pone esa clase .floating-nav.
import type { Dictionary } from '../i18n/types';
import LanguageSwitch from './LanguageSwitch.astro';
import T from './T.astro';
import { es } from '../i18n/es';
import { en } from '../i18n/en';
import { site } from '../data/site';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<header id="site-header" class="fixed inset-x-0 top-4 z-50 flex justify-center px-4 sm:top-6 sm:px-6">
  <div id="header-shell" class="w-full max-w-[1200px]">
    <div id="header-row" class="flex items-center justify-between gap-4 px-4 sm:px-6">
      <a href={dict.lang === 'es' ? '/' : '/en/'} class="flex shrink-0 items-center" aria-label="Tezontle 3D">
        <img src="/logo.svg" alt="" class="h-5 w-auto sm:h-6" />
      </a>

      <!-- Enlaces a secciones clave (SPEC: el header necesitaba "opciones", como el de
           referencia/taylor-website). Ocultos hasta lg: el selector de idioma de este sitio
           ocupa más que el de la referencia, así que a md: todavía no cabían cómodos. -->
      <nav aria-label={dict.nav.sectionsLabel} class="hidden items-center gap-6 lg:flex">
        <a href="#torre" class="nav-link text-sm font-medium whitespace-nowrap">
          <T es={es.nav.links.showroom} en={en.nav.links.showroom} lang={dict.lang} />
        </a>
        <a href="#comoTrabajamos" class="nav-link text-sm font-medium whitespace-nowrap">
          <T es={es.nav.links.comoTrabajamos} en={en.nav.links.comoTrabajamos} lang={dict.lang} />
        </a>
        <a href="#cierre" class="nav-link text-sm font-medium whitespace-nowrap">
          <T es={es.nav.links.contacto} en={en.nav.links.contacto} lang={dict.lang} />
        </a>
      </nav>

      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <button
          type="button"
          id="lang-trigger"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-controls="lang-panel"
          class="lang-trigger flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-sm font-semibold sm:px-3"
        >
          <img
            id="lang-trigger-flag"
            src={dict.lang === 'es' ? '/flags/mx.svg' : '/flags/gb.svg'}
            data-flag-es="/flags/mx.svg"
            data-flag-en="/flags/gb.svg"
            alt=""
            aria-hidden="true"
            class="h-3.5 w-5 shrink-0 rounded-[2px] object-cover"
          />
          <span id="lang-trigger-code" data-code-es="ES" data-code-en="EN">{dict.lang === 'es' ? 'ES' : 'EN'}</span>
          <svg
            class="lang-chevron h-2.5 w-3 shrink-0 transition-transform duration-300"
            viewBox="0 0 12 8"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M1 1.5 L6 6.5 L11 1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <a href={site.demoUrl} data-analytics-event="Ver demo" class="btn btn-primary shrink-0 whitespace-nowrap">
          <T es={es.scenes.cierre.buttons.demo} en={en.scenes.cierre.buttons.demo} lang={dict.lang} />
        </a>
      </div>
    </div>

    <LanguageSwitch dict={dict} />
  </div>
</header>

<style define:vars={{ ease: 'cubic-bezier(0.16, 1, 0.3, 1)' }}>
  #header-shell {
    background: color-mix(in oklab, var(--color-cal) 0%, transparent);
    backdrop-filter: blur(0px) saturate(100%);
    -webkit-backdrop-filter: blur(0px) saturate(100%);
    border: 1px solid transparent;
    border-radius: 9999px;
    overflow: hidden;
    transition:
      background-color 600ms var(--ease),
      border-color 600ms var(--ease),
      box-shadow 600ms var(--ease),
      border-radius 400ms var(--ease);
  }

  #site-header.floating-nav #header-shell,
  #site-header.panel-open #header-shell {
    background: color-mix(in oklab, var(--color-cal) 65%, transparent);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border-color: color-mix(in oklab, var(--color-grafito) 8%, transparent);
    box-shadow: 0 20px 40px -10px color-mix(in oklab, var(--color-grafito) 15%, transparent);
  }

  #site-header.panel-open #header-shell {
    border-radius: 24px;
  }

  #header-row {
    height: 76px;
    transition: height 600ms var(--ease);
  }

  #site-header.floating-nav #header-row {
    height: 60px;
  }

  /* Tinta del header: una sola, siempre (igual que la referencia de Taylor: nunca cambia
     según lo que haya detrás). Las piezas hijas (LanguageSwitch.astro) leen estas variables. */
  #site-header {
    --header-ink: var(--color-grafito);
    --header-ink-soft: color-mix(in oklab, var(--color-grafito) 8%, transparent);
  }

  .nav-link {
    color: var(--header-ink);
    opacity: 0.7;
    transition:
      opacity 300ms var(--ease),
      color 400ms var(--ease);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    opacity: 1;
  }

  .lang-trigger {
    color: var(--header-ink);
    box-shadow: inset 0 0 0 1px var(--header-ink-soft);
    transition:
      color 400ms var(--ease),
      box-shadow 400ms var(--ease),
      background-color 300ms var(--ease);
  }

  .lang-trigger:hover {
    background-color: var(--header-ink-soft);
  }

  #site-header.panel-open .lang-chevron {
    transform: rotate(180deg);
  }
</style>
