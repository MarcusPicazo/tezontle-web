---
// Header flotante (técnica de E:\referencias\taylor-website: index.html #navbar-wrapper,
// css/style.css #navbar/.floating-nav, js/animations.js el ScrollTrigger que pone esa
// clase), adaptado a los tokens de Tezontle. Una sola versión oscura (vidrio grafito) para
// todas las escenas: arriba del todo sigue transparente con texto grafito (va sobre la
// escena 1, clara); al pasar 50px aparece la píldora y el texto cambia a cal con la misma
// transición. src/scripts/header.ts solo pone la clase .floating-nav con el scroll.
import type { Dictionary } from '../i18n/types';
import LanguageSwitch from './LanguageSwitch.astro';
import T from './T.astro';
import { es } from '../i18n/es';
import { en } from '../i18n/en';

interface Props {
  dict: Dictionary;
  /** "Funciones" solo tiene sentido si la sección existe (src/utils/publicFile.ts:
   * featuresReady, mismo criterio que HomeContent.astro para mostrar la escena). */
  showFeatures?: boolean;
}

const { dict, showFeatures = true } = Astro.props;
---

<header id="site-header" class="fixed inset-x-0 top-4 z-50 flex justify-center px-4 sm:top-6 sm:px-6">
  <div id="header-shell" class="w-full max-w-[1200px]">
    <div id="header-row" class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 px-4 sm:px-6">
      <a
        id="header-logo-link"
        href={dict.lang === 'es' ? '/' : '/en/'}
        class="flex shrink-0 items-center justify-self-start"
        aria-label="Tezontle 3D"
      >
        <img src="/logo.svg" alt="" class="header-logo h-6 w-auto sm:h-7 lg:h-8" />
        <img src="/logo-light.svg" alt="" aria-hidden="true" class="header-logo header-logo-light h-6 w-auto sm:h-7 lg:h-8" />
      </a>

      <!-- Enlaces a secciones clave, centrados de verdad (grid 1fr/auto/1fr, no
           justify-between: con columnas de ancho distinto a los lados no quedaban al centro).
           Ocultos hasta lg: el selector de idioma de este sitio ocupa más que el de la
           referencia, así que a md: todavía no cabían cómodos. -->
      <!-- data-nav-link agrupa cada enlace con su grupo del raíl (src/data/scenes.ts): un
           solo observer en motion.ts prende raíl y header a la vez (ver ProgressRail.astro). -->
      <nav aria-label={dict.nav.sectionsLabel} class="col-start-2 hidden items-center gap-6 lg:flex">
        <a href="#experiencia" data-nav-link="showroom" class="nav-link text-[15px] font-medium whitespace-nowrap">
          <T es={es.nav.links.showroom} en={en.nav.links.showroom} lang={dict.lang} />
        </a>
        <a href="#paquete" data-nav-link="paquete" class="nav-link text-[15px] font-medium whitespace-nowrap">
          <T es={es.nav.links.paquete} en={en.nav.links.paquete} lang={dict.lang} />
        </a>
        {showFeatures && (
          <a href="#caracteristicas" data-nav-link="paquete" class="nav-link text-[15px] font-medium whitespace-nowrap">
            <T es={es.nav.links.caracteristicas} en={en.nav.links.caracteristicas} lang={dict.lang} />
          </a>
        )}
        <a href="#dondeEncaja" data-nav-link="proceso" class="nav-link text-[15px] font-medium whitespace-nowrap">
          <T es={es.nav.links.proceso} en={en.nav.links.proceso} lang={dict.lang} />
        </a>
        <a href="#contacto" data-nav-link="contacto" class="nav-link text-[15px] font-medium whitespace-nowrap">
          <T es={es.nav.links.contacto} en={en.nav.links.contacto} lang={dict.lang} />
        </a>
      </nav>

      <div class="col-start-3 flex shrink-0 items-center justify-self-end gap-2 sm:gap-3">
        <div class="relative">
          <button
            type="button"
            id="lang-trigger"
            aria-expanded="false"
            aria-haspopup="listbox"
            aria-controls="lang-panel"
            class="lang-trigger flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-sm font-semibold sm:px-3"
          >
            <span id="lang-trigger-code" data-code-es="ES" data-code-en="EN">{dict.lang === 'es' ? 'ES' : 'EN'}</span>
            <svg
              class="lang-chevron h-2.5 w-3 shrink-0 transition-transform duration-300"
              viewBox="0 0 12 8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M1 1.5 L6 6.5 L11 1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>

          <LanguageSwitch dict={dict} />
        </div>

        <!-- Lleva directo a "El paquete completo" (ahí están las demos reales de cada
             pieza), no a site.demoUrl (sigue siendo placeholder "#"). -->
        <a href="#paquete" data-analytics-event="Ver demo" class="btn btn-primary shrink-0 whitespace-nowrap font-semibold">
          <T es={es.scenes.cierre.buttons.demo} en={en.scenes.cierre.buttons.demo} lang={dict.lang} />
        </a>
      </div>
    </div>
  </div>
</header>

<style define:vars={{ ease: 'cubic-bezier(0.16, 1, 0.3, 1)' }}>
  #header-shell {
    background: transparent;
    backdrop-filter: blur(0px) saturate(100%);
    -webkit-backdrop-filter: blur(0px) saturate(100%);
    border: 1px solid transparent;
    border-radius: 9999px;
    box-shadow: none;
    transition:
      background-color 600ms var(--ease),
      border-color 600ms var(--ease),
      box-shadow 600ms var(--ease),
      border-radius 400ms var(--ease);
  }

  #site-header.floating-nav #header-shell {
    background: color-mix(in oklab, var(--color-grafito) 72%, transparent);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border-color: rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 12px 32px rgba(21, 23, 28, 0.18);
  }

  #header-row {
    height: 64px;
    transition: height 600ms var(--ease);
  }

  #site-header.floating-nav #header-row {
    height: 56px;
  }

  /* Tinta del header: grafito mientras es transparente (va sobre la escena 1, clara), cal
     en cuanto aparece la píldora oscura — nunca según qué escena haya detrás, siempre según
     este único estado de scroll. Las piezas hijas (LanguageSwitch.astro) leen estas
     variables, así no hay que repetir la condición en cada una. */
  #site-header {
    --header-ink: var(--color-grafito);
    --header-ink-soft: color-mix(in oklab, var(--color-grafito) 8%, transparent);
    --header-ink-soft-hover: color-mix(in oklab, var(--color-grafito) 14%, transparent);
  }

  #site-header.floating-nav {
    --header-ink: var(--color-cal);
    --header-ink-soft: rgba(255, 255, 255, 0.08);
    --header-ink-soft-hover: rgba(255, 255, 255, 0.16);
  }

  .header-logo-light {
    display: none;
  }

  #site-header.floating-nav .header-logo {
    display: none;
  }

  #site-header.floating-nav .header-logo-light {
    display: block;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    color: var(--header-ink);
    opacity: 0.85;
    padding-bottom: 2px;
    transition:
      opacity 300ms var(--ease),
      color 400ms var(--ease);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background-color: var(--color-laton);
    transition: right 300ms var(--ease);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.is-active {
    opacity: 1;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link.is-active::after {
    right: 0;
  }

  .lang-trigger {
    background-color: var(--header-ink-soft);
    color: var(--header-ink);
    transition:
      color 400ms var(--ease),
      background-color 400ms var(--ease);
  }

  .lang-trigger:hover {
    background-color: var(--header-ink-soft-hover);
  }

  #site-header.panel-open .lang-chevron {
    transform: rotate(180deg);
  }
</style>
