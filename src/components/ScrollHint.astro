---
// Aviso de "siga bajando" para toda la página (técnica de
// E:\referencias\taylor-website: index.html #scroll-hint + js/main.js initScrollHint),
// copiada y adaptada a los tokens de Tezontle. src/scripts/scrollHint.ts hace el mismo
// setInterval(200ms) que la referencia para decidir si se muestra.
import type { Dictionary } from '../i18n/types';
import T from './T.astro';
import { es } from '../i18n/es';
import { en } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<div
  id="scroll-hint"
  class="scroll-hint pointer-events-none fixed inset-x-0 bottom-8 z-40 flex flex-col items-center gap-2 opacity-0 transition-opacity duration-700"
  aria-hidden="true"
>
  <T
    as="span"
    id="scroll-hint-text"
    es={es.nav.scrollHint.hero}
    en={en.nav.scrollHint.hero}
    lang={dict.lang}
    data-hero-es={es.nav.scrollHint.hero}
    data-hero-en={en.nav.scrollHint.hero}
    data-rest-es={es.nav.scrollHint.rest}
    data-rest-en={en.nav.scrollHint.rest}
    class="block text-sm font-semibold tracking-[0.2em] text-grafito/60 uppercase"
  />
  <svg class="scroll-hint-arrow h-5 w-5 text-grafito/60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</div>

<style>
  .scroll-hint.is-dark #scroll-hint-text,
  .scroll-hint.is-dark .scroll-hint-arrow {
    color: color-mix(in oklab, var(--color-cal) 70%, transparent);
  }

  .scroll-hint-arrow {
    animation: scroll-hint-bounce 1.6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint-arrow {
      animation: none;
    }
  }

  @keyframes scroll-hint-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
</style>
