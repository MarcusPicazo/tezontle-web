---
// Aviso de "sigue bajando": aparece cuando el usuario deja de hacer scroll y todavía falta
// recorrido (src/scripts/scrollHint.ts mide la inactividad, no un IntersectionObserver —
// aquí sí hace falta un listener de scroll real, no hay forma de detectar "dejó de moverse"
// de otro modo). Se esconde apenas vuelve a hacer scroll o al llegar cerca del pie.
import type { Dictionary } from '../i18n/types';
import T from './T.astro';
import { es } from '../i18n/es';
import { en } from '../i18n/en';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<div id="scroll-hint" class="scroll-hint pointer-events-none fixed inset-x-0 bottom-6 z-40 flex justify-center sm:bottom-8" aria-hidden="true">
  <div
    class="flex items-center gap-2 rounded-full bg-cal/85 px-4 py-2 text-sm font-semibold text-grafito shadow-lg ring-1 ring-grafito/10 backdrop-blur-xl"
  >
    <T es={es.nav.scrollHint} en={en.nav.scrollHint} lang={dict.lang} />
    <svg class="scroll-hint-arrow h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M8 3v9M4 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>
</div>

<style>
  .scroll-hint {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 500ms var(--ease-fluid),
      transform 500ms var(--ease-fluid);
  }

  .scroll-hint.is-visible {
    opacity: 1;
    transform: none;
  }

  .scroll-hint-arrow {
    animation: scroll-hint-bounce 1.6s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint-arrow {
      animation: none;
    }
  }

  @keyframes scroll-hint-bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
</style>
