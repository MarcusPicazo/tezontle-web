---
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProgressRail from './ProgressRail.astro';
import ScrollWorld from './ScrollWorld.astro';
import Piedra from './scenes/Piedra.astro';
import Cimientos from './scenes/Cimientos.astro';
import Torre from './scenes/Torre.astro';
import Departamento from './scenes/Departamento.astro';
import Vendido from './scenes/Vendido.astro';
import Historia from './scenes/Historia.astro';
import ComoTrabajamos from './scenes/ComoTrabajamos.astro';
import Nombre from './scenes/Nombre.astro';
import Cierre from './scenes/Cierre.astro';
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;

// SPEC §3 y §4: escenas 1-3 comparten un mundo (clip-1 las une 1→2, clip-2 las une 2→3);
// la escena 9 es su propio mundo, solo (clip-3, 3→4).
const subida = {
  frames: [{ src: '/escenas/1-piedra.jpg' }, { src: '/escenas/2-cimientos.jpg' }, { src: '/escenas/3-torre.jpg' }],
  clips: [
    { desktop: '/escenas/clip-1-1920.mp4', mobile: '/escenas/clip-1-960.mp4' },
    { desktop: '/escenas/clip-2-1920.mp4', mobile: '/escenas/clip-2-960.mp4' },
  ],
};
const atardecer = {
  frames: [{ src: '/escenas/3-torre.jpg' }, { src: '/escenas/4-atardecer.jpg' }],
  clips: [{ desktop: '/escenas/clip-3-1920.mp4', mobile: '/escenas/clip-3-960.mp4' }],
};
---

<Header dict={dict} />
<ProgressRail dict={dict} />
<main id="contenido" class="relative z-10">
  <ScrollWorld frames={subida.frames} clips={subida.clips} eager>
    <Piedra t={dict.scenes.piedra} />
    <Cimientos t={dict.scenes.cimientos} />
    <Torre t={dict.scenes.torre} />
    <!-- SPEC §3: durante 3-5 el fondo sigue siendo el último cuadro de clip-2 (la torre
         completa), un poco atenuado — por eso Departamento y Vendido van dentro de este
         mismo mundo en vez de tener el suyo. -->
    <Departamento t={dict.scenes.departamento} />
    <Vendido t={dict.scenes.vendido} />
  </ScrollWorld>
  <Historia t={dict.scenes.historia} />
  <ComoTrabajamos t={dict.scenes.comoTrabajamos} />
  <Nombre t={dict.scenes.nombre} />
  <ScrollWorld frames={atardecer.frames} clips={atardecer.clips}>
    <Cierre t={dict.scenes.cierre} />
  </ScrollWorld>
</main>
<Footer dict={dict} />
