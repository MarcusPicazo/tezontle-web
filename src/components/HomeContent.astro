---
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProgressRail from './ProgressRail.astro';
import Piedra from './scenes/Piedra.astro';
import Cimientos from './scenes/Cimientos.astro';
import Torre from './scenes/Torre.astro';
import Departamento from './scenes/Departamento.astro';
import Vendido from './scenes/Vendido.astro';
import Historia from './scenes/Historia.astro';
import ComoTrabajamos from './scenes/ComoTrabajamos.astro';
import Nombre from './scenes/Nombre.astro';
import Cierre from './scenes/Cierre.astro';
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<div class="fixed inset-0 z-0 bg-noche pointer-events-none" aria-hidden="true">
  <div id="tower-canvas-root" class="h-full w-full"></div>
</div>
<script src="../scripts/towerGate.ts"></script>
<Header dict={dict} />
<ProgressRail dict={dict} />
<main id="contenido" class="relative z-10">
  <Piedra t={dict.scenes.piedra} />
  <Cimientos t={dict.scenes.cimientos} />
  <Torre t={dict.scenes.torre} />
  <Departamento t={dict.scenes.departamento} />
  <Vendido t={dict.scenes.vendido} />
  <Historia t={dict.scenes.historia} />
  <ComoTrabajamos t={dict.scenes.comoTrabajamos} />
  <Nombre t={dict.scenes.nombre} />
  <Cierre t={dict.scenes.cierre} />
</main>
<Footer dict={dict} />
