---
import Header from './Header.astro';
import Footer from './Footer.astro';
import ProgressRail from './ProgressRail.astro';
import ScrollHint from './ScrollHint.astro';
import WhatsappFab from './WhatsappFab.astro';
import ScrollWorld from './ScrollWorld.astro';
import Presentacion from './scenes/Presentacion.astro';
import Experiencia from './scenes/Experiencia.astro';
import Control from './scenes/Control.astro';
import Paquete from './scenes/Paquete.astro';
import ComoTrabajamos from './scenes/ComoTrabajamos.astro';
import Contacto from './scenes/Contacto.astro';
import Cierre from './scenes/Cierre.astro';
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;

// SPEC §3 y §4: escenas A-C comparten un mundo (clip-1 avanza durante A entera, clip-2
// durante B entera y se queda fijo en su último cuadro para C); el cierre es su propio
// mundo, solo (clip-3). Ni los fotogramas ni los clips cambiaron al bajar de 5 escenas a
// 3: cada clip simplemente pasa a ocupar el scroll completo de su escena.
const subida = {
  frames: [{ src: '/escenas/1-piedra.jpg' }, { src: '/escenas/2-cimientos.jpg' }, { src: '/escenas/3-torre.jpg' }],
  clips: [
    { desktop: '/escenas/clip-1-1920.mp4', mobile: '/escenas/clip-1-960.mp4' },
    { desktop: '/escenas/clip-2-1920.mp4', mobile: '/escenas/clip-2-960.mp4' },
  ],
};
const atardecer = {
  frames: [{ src: '/escenas/3-torre.jpg' }, { src: '/escenas/4-atardecer.jpg' }],
  clips: [{ desktop: '/escenas/clip-3-1920.mp4', mobile: '/escenas/clip-3-960.mp4' }],
};
---

<Header dict={dict} />
<ProgressRail dict={dict} />
<main id="contenido" class="relative z-10">
  <ScrollWorld frames={subida.frames} clips={subida.clips} eager>
    <Presentacion lang={dict.lang} />
    <Experiencia lang={dict.lang} />
    <Control lang={dict.lang} />
  </ScrollWorld>
  <Paquete lang={dict.lang} />
  <ComoTrabajamos lang={dict.lang} />
  <Contacto lang={dict.lang} />
  <ScrollWorld frames={atardecer.frames} clips={atardecer.clips}>
    <Cierre lang={dict.lang} />
  </ScrollWorld>
</main>
<Footer dict={dict} />
<ScrollHint dict={dict} />
<WhatsappFab />
