---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

{
  import.meta.env.DEV && (
    <p class:list={['rounded-lg bg-laton/15 px-3 py-2 text-xs text-grafito/70 ring-1 ring-laton/30', className]}>
      <strong class="font-semibold text-grafito">Pendiente:</strong> <slot />
    </p>
  )
}
