---
// Panel de opciones del selector de idioma: vive como hermano de #header-row dentro de
// #header-shell (Header.astro), para que sea el propio header el que se expanda hacia abajo
// (SPEC), no un menú flotante encima del contenido. El botón que lo abre está en Header.astro;
// aquí solo las dos opciones. El cambio real de texto lo hace src/scripts/i18n.ts (barrido,
// técnica de E:\referencias\taylor-website\js\i18n.js); src/scripts/header.ts solo abre/cierra
// esta tarjeta y llama a ese barrido cuando se elige una opción.
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;

const options = [
  { lang: 'es' as const, flag: '/flags/mx.svg', label: 'Español (México)' },
  { lang: 'en' as const, flag: '/flags/gb.svg', label: 'English (UK)' },
];
---

<div id="lang-panel" role="listbox" aria-label="Idioma / Language" class="lang-panel">
  <ul class="ml-auto flex w-full max-w-xs flex-col gap-1 p-2 sm:p-3">
    {
      options.map((opt) => (
        <li>
          <button
            type="button"
            role="option"
            aria-selected={dict.lang === opt.lang}
            data-lang-option={opt.lang}
            class="lang-option flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm"
          >
            <img src={opt.flag} alt="" aria-hidden="true" class="h-4 w-6 shrink-0 rounded-[2px] object-cover" />
            <span class="flex-1 font-medium">{opt.label}</span>
            <svg
              class="lang-check h-4 w-4 shrink-0 text-rojo-tezontle"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M3 8.5 L6.5 12 L13 4.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Oculto por defecto; header.ts anima la altura con GSAP al abrir/cerrar (no con CSS puro)
     para poder medir el alto real del contenido, que cambia entre ES y EN. */
  .lang-panel {
    height: 0;
    overflow: hidden;
    opacity: 0;
  }

  /* #site-header vive en Header.astro, fuera del alcance de este componente: sin :global()
     Astro también le agrega SU propio scope a ese selector y la regla nunca coincide con el
     #site-header real del DOM (tiene el scope de Header.astro, no el de este archivo). */
  :global(#site-header.panel-open) .lang-panel {
    opacity: 1;
  }

  .lang-option {
    color: var(--header-ink);
  }

  .lang-option:hover,
  .lang-option:focus-visible {
    background-color: var(--header-ink-soft);
  }

  .lang-option[aria-selected='true'] {
    background-color: var(--color-arena);
    color: var(--color-grafito);
  }

  .lang-check {
    opacity: 0;
  }

  .lang-option[aria-selected='true'] .lang-check {
    opacity: 1;
  }
</style>
