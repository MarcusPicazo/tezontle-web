---
// Panel de opciones del selector de idioma: tarjeta propia anclada bajo el botón (vive
// dentro del div.relative que lo envuelve en Header.astro), no el header completo
// expandiéndose. El cambio real de texto lo hace src/scripts/i18n.ts (barrido, técnica de
// E:\referencias\taylor-website\js\i18n.js); src/scripts/header.ts solo abre/cierra esta
// tarjeta (una clase, la transición es puro CSS) y llama a ese barrido al elegir una opción.
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;

// Sin bandera de país (solo el idioma, "ES"/"EN", como el selector de la demo real):
// Header.astro usa el mismo criterio para su disparador.
const options = [
  { lang: 'es' as const, label: 'Español' },
  { lang: 'en' as const, label: 'English' },
];
---

<div
  id="lang-panel"
  role="listbox"
  aria-label="Idioma / Language"
  class="lang-panel absolute top-[calc(100%+10px)] right-0 w-56 origin-top-right rounded-2xl p-1.5"
>
  <ul class="flex flex-col gap-1">
    {
      options.map((opt) => (
        <li>
          <button
            type="button"
            role="option"
            aria-selected={dict.lang === opt.lang}
            data-lang-option={opt.lang}
            class="lang-option flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm"
          >
            <span class="flex-1 font-medium">{opt.label}</span>
            <svg
              class="lang-check h-4 w-4 shrink-0 text-laton"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M3 8.5 L6.5 12 L13 4.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Tarjeta propia, siempre oscura (igual que la píldora del header al pasar 50px), sin
     depender de si el header está transparente arriba o no: flota con su propio fondo. */
  .lang-panel {
    background: color-mix(in oklab, var(--color-grafito) 90%, transparent);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 20px 40px -8px rgba(21, 23, 28, 0.35);
    opacity: 0;
    transform: scale(0.95) translateY(-4px);
    pointer-events: none;
    transition:
      opacity 250ms var(--ease-fluid),
      transform 250ms var(--ease-fluid);
  }

  /* #site-header vive en Header.astro, fuera del alcance de este componente: sin :global()
     Astro también le agrega SU propio scope a ese selector y la regla nunca coincide con el
     #site-header real del DOM (tiene el scope de Header.astro, no el de este archivo). */
  :global(#site-header.panel-open) .lang-panel {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .lang-option {
    color: var(--color-cal);
    transition: background-color 200ms var(--ease-fluid);
  }

  .lang-option:hover,
  .lang-option:focus-visible {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .lang-option[aria-selected='true'] {
    background-color: rgba(255, 255, 255, 0.08);
  }

  .lang-check {
    opacity: 0;
  }

  .lang-option[aria-selected='true'] .lang-check {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-panel {
      transition: opacity 150ms linear;
      transform: none;
    }
  }
</style>
